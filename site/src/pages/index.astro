---
import Base from '../layouts/Base.astro';
import HeroSieve from '../components/HeroSieve.astro';
import BudgetDemo from '../components/BudgetDemo.astro';
import SignatureDemo from '../components/SignatureDemo.astro';
import CodeBlock from '../components/CodeBlock.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import TuiPicker from '../components/TuiPicker.astro';
import { toBase, repoUrl, curlInstall } from '../lib/site';

const commands: [string, string][] = [
  ['sift', 'Launch the interactive picker'],
  ['sift dump [path]', 'Render every eligible file in the tree'],
  ['sift pick [path]', 'Select files interactively, then render'],
  ['sift select [path]', 'Auto-select the most useful files and render them'],
  ['sift diff [ref]', 'Render only files changed relative to a git ref'],
  ['sift delta [path]', 'Render only changes since the last recorded dump'],
  ['sift watch [path]', 'Re-render the document whenever files change'],
  ['sift serve', 'Local, password-locked web UI (alternative to the terminal picker)'],
];

const largeFeatures = [
  {
    title: 'Git-relevance ranking.',
    text: 'Modified files first, then recent diffs, then recent commits, weighted with churn and import fan-in, so the files you actually touched lead the document.',
    icon: 'rank' as const,
  },
  {
    title: 'Signature compression.',
    text: '`--mode signatures` keeps declarations and doc comments via tree-sitter and drops function bodies. The full structure at a fraction of the tokens.',
    icon: 'signature' as const,
  },
];

const smallFeatures = [
  {
    title: 'Token budgets.',
    text: "Set `--budget` and sift keeps the highest-priority files inside your model's context window.",
    icon: 'budget' as const,
  },
  {
    title: 'Secret redaction.',
    text: 'AWS, GitHub, Slack, Google, and Stripe keys are redacted before anything renders. On by default.',
    icon: 'secret' as const,
  },
  {
    title: 'Interactive picker.',
    text: 'A dual-pane TUI with per-file FULL/SIGS/SKIP modes, smart-select, and task prompts.',
    icon: 'picker' as const,
  },
  {
    title: 'Incremental deltas.',
    text: '`sift delta` renders only what changed since your last dump, as full files or a raw patch.',
    icon: 'delta' as const,
  },
];

const mcpTools: [string, string][] = [
  ['pack_context', 'Pack ranked, budgeted context for a path.'],
  ['pack_diff', 'Pack only files changed relative to a git ref.'],
  ['list_tree', 'List the project tree the agent can choose from.'],
];

function rich(text: string): string {
  return text.replace(/`([^`]+)`/g, '<code>$1</code>');
}
---

<Base
  title="sift"
  description="sift walks a project directory, ranks files by git relevance, and renders one LLM-ready context document that fits a model's context window."
>
  <main id="main">
    <section class="hero">
      <div class="container">
        <div class="hero-pill">MIT · single Go binary · local-first</div>
        <h1>
          Sift the repo.<br />
          Keep the <span class="accent">signal.</span>
        </h1>
        <p class="lede">
          sift walks a project directory, ranks files by git relevance, and renders one LLM-ready context document. Token budgeting, secret redaction, and signature-only compression are built in.
        </p>
        <div class="hero-actions">
          <a class="button" href={toBase('/install/')}>Install sift</a>
          <a class="button ghost" href={toBase('/docs/')}>Read the docs</a>
        </div>
        <p class="hero-meta">
          Single Go binary, no account or server round-trip. Also on Homebrew, Scoop, and as{' '}
          <a href={`${repoUrl}/releases/latest`} target="_blank" rel="noopener noreferrer" class="external">prebuilt binaries</a>.{' '}
          <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="external">Source on GitHub</a>.
        </p>
        <HeroSieve />
      </div>
    </section>

    <section class="section alt">
      <div class="container">
        <div class="section-head">
          <h2>Context curation is the bottleneck</h2>
          <p class="lede">Three ways teams feed code to models today, and why each breaks down.</p>
        </div>
        <div>
          <div class="reason-row">
            <span class="reason-arrow" aria-hidden="true">→</span>
            <p><strong>Raw concatenation doesn&apos;t rank.</strong> Piping every file into a prompt ships vendored code, lockfiles, build output, and secrets, unranked and over budget.</p>
          </div>
          <div class="reason-row">
            <span class="reason-arrow" aria-hidden="true">→</span>
            <p><strong>A cloud service sees your code.</strong> Hosted context tools charge per seat and upload your repository. sift is a local MIT-licensed binary. Nothing leaves your machine.</p>
          </div>
          <div class="reason-row">
            <span class="reason-arrow" aria-hidden="true">→</span>
            <p><strong>Hand-picking doesn&apos;t scale.</strong> Choosing files by hand stops working past a dozen. Git-relevance ranking re-curates on every run, for free.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="what-it-does">
      <div class="container">
        <div class="section-head">
          <h2>One document, ranked and trimmed to fit</h2>
          <p class="lede">Two ideas do the heavy lifting. Four more handle the details.</p>
        </div>
        <div class="large-features">
          {largeFeatures.map((feature) => (
            <article class="feature-card">
              <FeatureIcon kind={feature.icon} />
              <h3>{feature.title}</h3>
              <p set:html={rich(feature.text)} />
            </article>
          ))}
        </div>
        <div class="small-features">
          {smallFeatures.map((feature) => (
            <article class="small-feature">
              <FeatureIcon kind={feature.icon} />
              <h3>{feature.title}</h3>
              <p set:html={rich(feature.text)} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">TRY IT</p>
          <h2>Drag the budget. Watch the document reshape.</h2>
          <p class="lede">An illustrative simulation of how sift fills a token budget by rank.</p>
        </div>
        <BudgetDemo />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Same file. A fraction of the tokens.</h2>
        </div>
        <SignatureDemo />
      </div>
    </section>

    <section class="section alt">
      <div class="container">
        <div class="section-head">
          <h2>Eight ways to generate the document</h2>
          <p class="lede">Run <code>sift --help</code> or <code>sift &lt;command&gt; --help</code> for the full flag list.</p>
        </div>
        <div class="table-scroll">
          <table class="commands-table">
            <thead>
              <tr>
                <th scope="col">Command</th>
                <th scope="col">What it does</th>
              </tr>
            </thead>
            <tbody>
              {commands.map(([command, description]) => (
                <tr>
                  <td><code>{command}</code></td>
                  <td>{description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>A picker built for the keyboard</h2>
          <p class="lede">Mark files FULL, SIGS, or SKIP and watch the token total move.</p>
        </div>
        <TuiPicker />
        <p class="footnote">Illustrative layout.</p>
      </div>
    </section>

    <section class="section alt">
      <div class="container">
        <div class="section-head">
          <h2>Built for agents too</h2>
          <p class="lede">sift ships an MCP server so coding agents can request exactly the context they need, over stdio.</p>
        </div>
        <div class="mcp-grid">
          {mcpTools.map(([name, text]) => (
            <article class="mcp-card">
              <h3>{name}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <a class="text-link" href={toBase('/docs/mcp/')}>MCP server docs →</a>
      </div>
    </section>

    <section class="section install-strip">
      <div class="container">
        <h2>Install in one line</h2>
        <p class="lede">macOS and Linux:</p>
        <CodeBlock code={curlInstall} />
        <p class="install-more">
          Homebrew, Scoop, <code>go install</code>, and building from source are on the{' '}
          <a class="text-link" href={toBase('/install/')}>install page</a>.
        </p>
      </div>
    </section>
  </main>
</Base>
